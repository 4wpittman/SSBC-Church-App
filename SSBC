<script type="module">
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
import { supabaseConfig } from "./supabase-config.js";

const supabase = createClient(supabaseConfig.url, supabaseConfig.anonKey);

function showTab(name){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById('screen-'+name).classList.add('active');
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  var tabEl = document.querySelector('.tab[data-tab="'+name+'"]');
  if(tabEl) tabEl.classList.add('active');
  document.querySelector('.screens').scrollTop = 0;
}
function openScreen(name){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(name.startsWith('screen-') ? name : 'screen-'+name).classList.add('active');
  document.querySelector('.screens').scrollTop = 0;
}
function selectAmt(el){
  document.querySelectorAll('.amt').forEach(a=>a.classList.remove('selected'));
  el.classList.add('selected');
  var btn = document.querySelector('.give-cta');
  var val = el.textContent.trim();
  btn.textContent = (val === 'Other') ? 'Continue' : ('Give ' + val + ' now');
}
async function submitPrayer(){
  const name = document.getElementById('prayerName').value.trim();
  const text = document.getElementById('prayerText').value.trim();
  const privacySel = document.getElementById('prayerPrivacy').value;
  if(!text){ return; }
  const btn = document.getElementById('prayerSubmitBtn');
  btn.disabled = true;
  btn.textContent = 'Sending...';
  try{
    const { error } = await supabase.from('prayer_requests').insert({
      name: name || 'Anonymous',
      request: text,
      privacy: privacySel,
      handled: false
    });
    if(error) throw error;
    document.getElementById('prayerName').value = '';
    document.getElementById('prayerText').value = '';
    document.getElementById('prayerConfirm').style.display = 'block';
  }catch(e){
    console.error('prayer request failed', e);
    alert('Something went wrong sending your request — please try again in a moment.');
  }finally{
    btn.disabled = false;
    btn.textContent = 'Send request';
  }
}
function filterGroups(chip, cat){
  document.querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));
  chip.classList.add('active');
  document.querySelectorAll('.group-card').forEach(g=>{
    g.style.display = (cat === 'all' || g.dataset.cat === cat) ? '' : 'none';
  });
}
window.showTab = showTab;
window.openScreen = openScreen;
window.selectAmt = selectAmt;
window.submitPrayer = submitPrayer;
window.filterGroups = filterGroups;

(function(){
  var h = new Date().getHours();
  var g = h < 12 ? 'Good morning.' : h < 18 ? 'Good afternoon.' : 'Good evening.';
  document.getElementById('greetingText').textContent = g;
})();

/* --- helpers --- */
function initials(name){
  return (name || '').split(' ').filter(Boolean).map(w=>w[0]).join('').slice(0,2).toUpperCase();
}
function formatBadge(iso){
  if(!iso) return {mo:'', dd:''};
  var d = new Date(iso + 'T00:00:00');
  return { mo: d.toLocaleDateString('en-US',{month:'short'}).toUpperCase(), dd: String(d.getDate()).padStart(2,'0') };
}
function formatDisplay(iso){
  if(!iso) return '';
  var d = new Date(iso + 'T00:00:00');
  return d.toLocaleDateString('en-US',{month:'short', day:'numeric'});
}
function todayISO(){
  var d = new Date();
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}
function esc(s){
  var d = document.createElement('div');
  d.textContent = s || '';
  return d.innerHTML;
}

/* --- render functions --- */
function renderEventRow(ev){
  var b = formatBadge(ev.event_date);
  return '<div class="event-row"><div class="date-badge"><div class="mo">'+esc(b.mo)+'</div><div class="dd">'+esc(b.dd)+'</div></div>'
    + '<div><div class="card-title" style="font-size:14.5px;">'+esc(ev.title)+'</div><div class="card-meta">'+esc(ev.time||'')+(ev.location ? ' · '+esc(ev.location) : '')+'</div></div></div>';
}
function renderSermonCard(s){
  return '<div class="arch-card"><span class="tag sermon">'+esc(s.series||'Sermon')+'</span>'
    + '<div class="card-title">'+esc(s.title)+'</div><div class="card-meta">'+esc(s.speaker||'')+' · '+esc(formatDisplay(s.sermon_date))+'</div>'
    + '<div class="play-row"><button class="play-btn" onclick="alert(\'Prototype only — audio streaming connects here.\')"><svg viewBox="0 0 24 24" fill="#F8F6F1"><path d="M8 5v14l11-7z"/></svg></button><div class="track"></div><div class="dur">'+esc(s.duration||'')+'</div></div></div>';
}
function renderBioCard(p){
  return '<div class="bio-card"><div class="bio-avatar">'+esc(p.initials||initials(p.name))+'</div>'
    + '<div><div class="bio-name">'+esc(p.name)+'</div><div class="bio-role">'+esc(p.role||'')+'</div><div class="bio-text">'+esc(p.bio||'')+'</div></div></div>';
}
function renderPersonRow(p, withContact){
  return '<div class="person-row"><div class="avatar">'+esc(p.initials||initials(p.name))+'</div>'
    + '<div><div class="person-name">'+esc(p.name)+'</div><div class="person-role">'+esc(p.role||'')+'</div>'
    + (withContact && p.phone ? '<div class="person-contact">'+esc(p.phone)+'</div>' : '') + '</div></div>';
}
function renderGroupCard(g){
  return '<div class="group-card" data-cat="'+esc(g.category||'')+'"><div class="g-title">'+esc(g.title)+'</div>'
    + '<div class="g-meta">'+esc(g.meta||'')+'</div><div class="g-desc">'+esc(g.description||'')+'</div></div>';
}

async function loadSettings(){
  try{
    const { data: s, error } = await supabase.from('settings').select('*').eq('id',1).single();
    if(error || !s) return;
    document.getElementById('sundayTimeText').textContent = s.sunday_times || '—';
    document.getElementById('wedTimeText').textContent = s.wednesday_times || '—';
    document.getElementById('visitAddress').textContent = s.address_line || '—';
    document.getElementById('visitPhone').textContent = s.phone || '—';
    document.getElementById('giveTextPhone').textContent = s.phone || '—';
    document.getElementById('giveMailAddress').textContent = s.address_line || '—';
    const liveBanner = document.getElementById('liveBanner');
    if(s.is_live){
      document.getElementById('liveTitleText').textContent = s.live_title || 'Live now';
      document.getElementById('liveSubText').textContent = s.live_sub || 'Tap to watch the service';
      liveBanner.style.display = 'flex';
    } else {
      liveBanner.style.display = 'none';
    }
  }catch(e){ console.error('settings load failed', e); }
}

async function loadSermons(){
  try{
    const { data: items, error } = await supabase.from('sermons').select('*').order('sermon_date', { ascending:false });
    if(error) throw error;
    const listEl = document.getElementById('sermonsList');
    const homeEl = document.getElementById('homeLatestSermon');
    if(!items || items.length === 0){
      listEl.innerHTML = '<div class="card-desc">No sermons posted yet.</div>';
      homeEl.innerHTML = '<div class="card-desc">No sermons posted yet.</div>';
      return;
    }
    listEl.innerHTML = items.map(renderSermonCard).join('');
    homeEl.innerHTML = renderSermonCard(items[0]);
  }catch(e){ console.error('sermons load failed', e); }
}

async function loadEvents(){
  try{
    const { data: items, error } = await supabase.from('events').select('*').order('event_date', { ascending:true });
    if(error) throw error;
    const listEl = document.getElementById('eventsList');
    const homeEl = document.getElementById('homeNextEvent');
    if(!items || items.length === 0){
      listEl.innerHTML = '<div class="card-desc">No upcoming events posted yet.</div>';
      homeEl.innerHTML = '<div class="card-desc">No upcoming events posted yet.</div>';
      return;
    }
    listEl.innerHTML = items.map(renderEventRow).join('');
    const today = todayISO();
    const next = items.find(e => (e.event_date||'') >= today) || items[0];
    homeEl.innerHTML = renderEventRow(next);
  }catch(e){ console.error('events load failed', e); }
}

async function loadLeadership(){
  try{
    const { data: items, error } = await supabase.from('leadership').select('*').order('created_at', { ascending:true });
    if(error) throw error;
    const listEl = document.getElementById('leadershipList');
    const previewEl = document.getElementById('connectLeadershipPreview');
    if(!items || items.length === 0){
      listEl.innerHTML = '<div class="card-desc">No staff listed yet.</div>';
      previewEl.innerHTML = '<div class="card-desc">No staff listed yet.</div>';
      return;
    }
    listEl.innerHTML = items.map(renderBioCard).join('');
    previewEl.innerHTML = renderBioCard(items[0]);
  }catch(e){ console.error('leadership load failed', e); }
}

async function loadDeacons(){
  try{
    const { data: items, error } = await supabase.from('deacons').select('*').order('created_at', { ascending:true });
    if(error) throw error;
    const listEl = document.getElementById('deaconsList');
    listEl.innerHTML = (items && items.length) ? items.map(p=>renderPersonRow(p,true)).join('') : '<div class="card-desc">No deacons listed yet.</div>';
  }catch(e){ console.error('deacons load failed', e); }
}

async function loadDirectory(){
  try{
    const { data: items, error } = await supabase.from('directory').select('*').order('name', { ascending:true });
    if(error) throw error;
    const listEl = document.getElementById('directoryList');
    listEl.innerHTML = (items && items.length) ? items.map(p=>renderPersonRow(p,false)).join('') : '<div class="card-desc">No directory entries yet.</div>';
  }catch(e){ console.error('directory load failed', e); }
}

async function loadGroups(){
  try{
    const { data: items, error } = await supabase.from('groups').select('*').order('created_at', { ascending:true });
    if(error) throw error;
    const listEl = document.getElementById('groupsList');
    listEl.innerHTML = (items && items.length) ? items.map(renderGroupCard).join('') : '<div class="card-desc">No groups listed yet.</div>';
  }catch(e){ console.error('groups load failed', e); }
}

loadSettings();
loadSermons();
loadEvents();
loadLeadership();
loadDeacons();
loadDirectory();
loadGroups();

/* --- PWA install + offline support ---
   These only activate for real once this file is hosted (HTTPS), alongside
   manifest.json and sw.js in the same folder. In a preview sandbox the
   browser won't fire an install prompt or register the worker, so this
   fails silently on purpose. */
let deferredPrompt;
window.addEventListener('beforeinstallprompt', (e) => {
  e.preventDefault();
  deferredPrompt = e;
  document.getElementById('installBanner').classList.add('show');
});
window.installApp = function(){
  if(!deferredPrompt) return;
  deferredPrompt.prompt();
  deferredPrompt.userChoice.finally(() => {
    deferredPrompt = null;
    document.getElementById('installBanner').classList.remove('show');
  });
};
if('serviceWorker' in navigator){
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('sw.js').catch(() => { /* not hosted yet — expected in preview */ });
  });
}
</script>

