<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Staff Dashboard — Smiths Station Baptist Church</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#1C2B4A; --navy-deep:#131E33; --gold:#D9A441; --gold-soft:#F0DDB0;
    --paper:#F8F6F1; --paper-dim:#EFEBE1; --brick:#8B4A3B; --sage:#6E7F5C;
    --ink:#2A2520; --ink-soft:#6B655C; --danger:#B3432D;
  }
  *{box-sizing:border-box;}
  body{margin:0; font-family:'Inter',sans-serif; background:var(--paper); color:var(--ink);}
  h1,h2,h3{font-family:'Fraunces',serif; margin:0; font-weight:600;}

  #loginScreen{min-height:100vh; display:flex; align-items:center; justify-content:center; padding:20px;}
  .login-box{background:#fff; border:1px solid #E4DFD3; border-radius:16px; padding:32px 28px; width:100%; max-width:360px;}
  .login-box h1{font-size:20px; color:var(--navy); margin-bottom:4px;}
  .login-box .sub{font-size:13px; color:var(--ink-soft); margin-bottom:22px;}
  .field{margin-bottom:14px;}
  .field label{display:block; font-size:12.5px; font-weight:600; color:var(--ink-soft); margin-bottom:6px;}
  .field input, .field select, .field textarea{width:100%; border:1px solid #DCD5C4; background:#fff; border-radius:8px; padding:10px 12px; font-family:inherit; font-size:14px; color:var(--ink);}
  .field textarea{min-height:70px; resize:vertical;}
  .btn{background:var(--navy); color:#fff; border:none; padding:11px 16px; border-radius:8px; font-size:14px; font-weight:700; font-family:inherit; cursor:pointer;}
  .btn.gold{background:var(--gold); color:var(--navy-deep);}
  .btn.danger{background:var(--danger); color:#fff;}
  .btn.ghost{background:none; color:var(--navy); border:1px solid #DCD5C4;}
  .btn.small{padding:7px 12px; font-size:12.5px;}
  .btn.block{width:100%;}
  .toggle-link{background:none; border:none; color:var(--brick); font-size:12.5px; font-weight:600; cursor:pointer; font-family:inherit; padding:0; margin-top:14px;}
  #loginError{color:var(--danger); font-size:13px; margin-top:10px; display:none;}
  #loginNotice{color:var(--sage); font-size:13px; margin-top:10px; display:none;}

  #dashboard{display:none;}
  .topbar{background:var(--navy); color:#fff; padding:14px 20px; display:flex; align-items:center; justify-content:space-between;}
  .topbar h1{font-size:16px;}
  .topbar .who{font-size:12px; color:var(--gold-soft); margin-top:2px;}
  .layout{display:flex; max-width:1100px; margin:0 auto;}
  .nav{width:190px; flex-shrink:0; padding:20px 12px; border-right:1px solid #E4DFD3; min-height:calc(100vh - 60px);}
  .nav button{display:block; width:100%; text-align:left; background:none; border:none; padding:10px 12px; border-radius:8px; font-size:13.5px; font-weight:600; color:var(--ink-soft); cursor:pointer; margin-bottom:2px; font-family:inherit;}
  .nav button.active{background:var(--paper-dim); color:var(--navy);}
  .content{flex:1; padding:24px 28px;}
  .panel{display:none;}
  .panel.active{display:block;}
  .panel-head{display:flex; align-items:center; justify-content:space-between; margin-bottom:18px;}
  .panel-head h2{font-size:19px;}

  table{width:100%; border-collapse:collapse; background:#fff; border:1px solid #E4DFD3; border-radius:10px; overflow:hidden;}
  th{text-align:left; font-size:11.5px; text-transform:uppercase; letter-spacing:.03em; color:var(--ink-soft); background:var(--paper-dim); padding:10px 12px;}
  td{padding:10px 12px; font-size:13.5px; border-top:1px solid #EFEBE1;}
  td.actions{white-space:nowrap; text-align:right;}
  td.actions button{margin-left:6px;}

  .form-card{background:#fff; border:1px solid #E4DFD3; border-radius:12px; padding:18px 20px; margin-top:16px; max-width:480px;}
  .form-card h3{font-size:14px; margin-bottom:14px;}
  .form-row{display:flex; gap:10px;}
  .form-row .field{flex:1;}
  .status-msg{font-size:12.5px; margin-top:10px; display:none;}
  .status-msg.ok{color:var(--sage);}
  .status-msg.err{color:var(--danger);}
  .empty-note{font-size:13px; color:var(--ink-soft); padding:14px 0;}
</style>
</head>
<body>

<div id="loginScreen">
  <div class="login-box">
    <h1 id="loginHeading">Staff dashboard</h1>
    <div class="sub" id="loginSub">Sign in to edit content for Smiths Station Baptist Church.</div>
    <div class="field"><label>Email</label><input type="email" id="loginEmail" placeholder="you@ssbc.org"></div>
    <div class="field"><label>Password</label><input type="password" id="loginPassword" placeholder="At least 6 characters"></div>
    <button class="btn block" id="loginSubmitBtn" onclick="doLogin()">Sign in</button>
    <div id="loginError"></div>
    <div id="loginNotice"></div>
    <button class="toggle-link" onclick="toggleMode()" id="toggleModeBtn">First time here? Create a staff account →</button>
  </div>
</div>

<div id="dashboard">
  <div class="topbar">
    <div>
      <h1>Smiths Station Baptist — Staff dashboard</h1>
      <div class="who" id="whoText"></div>
    </div>
    <button class="btn ghost" style="color:#fff; border-color:rgba(255,255,255,.4);" onclick="doLogout()">Sign out</button>
  </div>
  <div class="layout">
    <div class="nav">
      <button class="active" data-panel="settings" onclick="showPanel('settings')">Service times &amp; live</button>
      <button data-panel="sermons" onclick="showPanel('sermons')">Sermons</button>
      <button data-panel="events" onclick="showPanel('events')">Events</button>
      <button data-panel="leadership" onclick="showPanel('leadership')">Leadership</button>
      <button data-panel="deacons" onclick="showPanel('deacons')">Deacons</button>
      <button data-panel="groups" onclick="showPanel('groups')">Connect groups</button>
      <button data-panel="directory" onclick="showPanel('directory')">Directory</button>
      <button data-panel="prayers" onclick="showPanel('prayers')">Prayer requests</button>
    </div>
    <div class="content">

      <div class="panel active" id="panel-settings">
        <div class="panel-head"><h2>Service times &amp; live status</h2></div>
        <div class="form-card">
          <div class="form-row">
            <div class="field"><label>Sunday times</label><input id="s_sunday" placeholder="9:30 & 10:45am"></div>
            <div class="field"><label>Wednesday times</label><input id="s_wed" placeholder="6:30pm"></div>
          </div>
          <div class="field"><label>Address</label><input id="s_address" placeholder="2210 Lee Rd, Smiths Station, AL 36877"></div>
          <div class="field"><label>Phone</label><input id="s_phone" placeholder="(334) 555-0142"></div>
          <div class="field"><label><input type="checkbox" id="s_isLive" style="width:auto; margin-right:6px;">Show "Live now" banner</label></div>
          <div class="form-row">
            <div class="field"><label>Live title</label><input id="s_liveTitle" placeholder="Live now · Sunday worship"></div>
            <div class="field"><label>Live subtitle</label><input id="s_liveSub" placeholder="Tap to watch the service"></div>
          </div>
          <button class="btn gold" onclick="saveSettings()">Save</button>
          <div class="status-msg" id="settingsStatus"></div>
        </div>
      </div>

      <div class="panel" id="panel-sermons">
        <div class="panel-head"><h2>Sermons</h2><button class="btn small gold" onclick="openForm('sermons')">Add sermon</button></div>
        <table><thead><tr><th>Title</th><th>Speaker</th><th>Date</th><th></th></tr></thead><tbody id="tbl-sermons"></tbody></table>
        <div id="form-sermons"></div>
      </div>

      <div class="panel" id="panel-events">
        <div class="panel-head"><h2>Events</h2><button class="btn small gold" onclick="openForm('events')">Add event</button></div>
        <table><thead><tr><th>Title</th><th>Date</th><th>Time</th><th></th></tr></thead><tbody id="tbl-events"></tbody></table>
        <div id="form-events"></div>
      </div>

      <div class="panel" id="panel-leadership">
        <div class="panel-head"><h2>Leadership</h2><button class="btn small gold" onclick="openForm('leadership')">Add staff member</button></div>
        <table><thead><tr><th>Name</th><th>Role</th><th></th></tr></thead><tbody id="tbl-leadership"></tbody></table>
        <div id="form-leadership"></div>
      </div>

      <div class="panel" id="panel-deacons">
        <div class="panel-head"><h2>Deacons</h2><button class="btn small gold" onclick="openForm('deacons')">Add deacon</button></div>
        <table><thead><tr><th>Name</th><th>Role</th><th>Phone</th><th></th></tr></thead><tbody id="tbl-deacons"></tbody></table>
        <div id="form-deacons"></div>
      </div>

      <div class="panel" id="panel-groups">
        <div class="panel-head"><h2>Connect groups</h2><button class="btn small gold" onclick="openForm('groups')">Add group</button></div>
        <table><thead><tr><th>Title</th><th>Category</th><th>Meets</th><th></th></tr></thead><tbody id="tbl-groups"></tbody></table>
        <div id="form-groups"></div>
      </div>

      <div class="panel" id="panel-directory">
        <div class="panel-head"><h2>Directory</h2><button class="btn small gold" onclick="openForm('directory')">Add entry</button></div>
        <table><thead><tr><th>Name</th><th>Role</th><th></th></tr></thead><tbody id="tbl-directory"></tbody></table>
        <div id="form-directory"></div>
      </div>

      <div class="panel" id="panel-prayers">
        <div class="panel-head"><h2>Prayer requests</h2></div>
        <table><thead><tr><th>Name</th><th>Request</th><th>Sharing</th><th>Received</th><th>Prayed for?</th><th></th></tr></thead><tbody id="tbl-prayers"></tbody></table>
      </div>

    </div>
  </div>
</div>

<script type="module">
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
import { supabaseConfig } from "./supabase-config.js";

const supabase = createClient(supabaseConfig.url, supabaseConfig.anonKey);

let mode = 'signin';

const SCHEMAS = {
  sermons: [['title','Title','text'],['series','Series','text'],['speaker','Speaker','text'],['sermon_date','Date','date'],['duration','Duration (e.g. 18:42)','text']],
  events: [['title','Title','text'],['event_date','Date','date'],['time','Time (e.g. 10:45am)','text'],['location','Location','text']],
  leadership: [['name','Name','text'],['role','Role','text'],['bio','Bio','textarea'],['initials','Initials (optional)','text']],
  deacons: [['name','Name','text'],['role','Role','text'],['phone','Phone','text'],['initials','Initials (optional)','text']],
  groups: [['title','Title','text'],['category',"Category (men/women/youth/young/senior)",'text'],['meta','Meets (e.g. Tuesdays, 6:00am · Fellowship Hall)','text'],['description','Description','textarea']],
  directory: [['name','Name','text'],['role','Role / note','text'],['initials','Initials (optional)','text']]
};
const TABLE_COLS = {
  sermons: ['title','speaker','sermon_date'],
  events: ['title','event_date','time'],
  leadership: ['name','role'],
  deacons: ['name','role','phone'],
  groups: ['title','category','meta'],
  directory: ['name','role']
};

let currentEditId = {};

window.showPanel = function(name){
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('panel-'+name).classList.add('active');
  document.querySelectorAll('.nav button').forEach(b=>b.classList.remove('active'));
  document.querySelector('.nav button[data-panel="'+name+'"]').classList.add('active');
};

window.toggleMode = function(){
  mode = mode === 'signin' ? 'signup' : 'signin';
  document.getElementById('loginHeading').textContent = mode === 'signup' ? 'Create staff account' : 'Staff dashboard';
  document.getElementById('loginSub').textContent = mode === 'signup'
    ? 'Set up a login for yourself or a staff member.'
    : 'Sign in to edit content for Smiths Station Baptist Church.';
  document.getElementById('loginSubmitBtn').textContent = mode === 'signup' ? 'Create account' : 'Sign in';
  document.getElementById('toggleModeBtn').textContent = mode === 'signup' ? '← Back to sign in' : 'First time here? Create a staff account →';
  document.getElementById('loginError').style.display = 'none';
  document.getElementById('loginNotice').style.display = 'none';
};

window.doLogin = async function(){
  const email = document.getElementById('loginEmail').value.trim();
  const pass = document.getElementById('loginPassword').value;
  const errEl = document.getElementById('loginError');
  const noticeEl = document.getElementById('loginNotice');
  errEl.style.display = 'none';
  noticeEl.style.display = 'none';

  if(mode === 'signup'){
    const { error } = await supabase.auth.signUp({ email, password: pass });
    if(error){
      errEl.textContent = error.message;
      errEl.style.display = 'block';
      return;
    }
    noticeEl.textContent = 'Account created. If email confirmation is on, check your inbox — otherwise you can sign in now.';
    noticeEl.style.display = 'block';
    window.toggleMode();
  } else {
    const { error } = await supabase.auth.signInWithPassword({ email, password: pass });
    if(error){
      errEl.textContent = error.message;
      errEl.style.display = 'block';
    }
  }
};
window.doLogout = function(){ supabase.auth.signOut(); };

supabase.auth.onAuthStateChange((event, session) => {
  if(session && session.user){
    document.getElementById('loginScreen').style.display = 'none';
    document.getElementById('dashboard').style.display = 'block';
    document.getElementById('whoText').textContent = 'Signed in as ' + session.user.email;
    loadAllTables();
  } else {
    document.getElementById('loginScreen').style.display = 'flex';
    document.getElementById('dashboard').style.display = 'none';
  }
});

function esc(s){ const d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }

async function loadAllTables(){
  for(const key of Object.keys(SCHEMAS)){ await renderTable(key); }
  await loadSettingsForm();
  await renderPrayerRequests();
}

async function renderTable(key){
  const { data: items, error } = await supabase.from(key).select('*').order('created_at', { ascending:false });
  const tbody = document.getElementById('tbl-'+key);
  const cols = TABLE_COLS[key];
  if(error || !items || items.length === 0){
    tbody.innerHTML = '<tr><td colspan="'+(cols.length+1)+'" class="empty-note">Nothing added yet.</td></tr>';
    return;
  }
  tbody.innerHTML = items.map(item => {
    let cells = cols.map(c => '<td>'+esc(item[c])+'</td>').join('');
    return '<tr>'+cells+'<td class="actions">'
      + '<button class="btn small ghost" onclick="editItem(\''+key+'\',\''+item.id+'\')">Edit</button>'
      + '<button class="btn small danger" onclick="deleteItem(\''+key+'\',\''+item.id+'\')">Delete</button>'
      + '</td></tr>';
  }).join('');
}

window.openForm = function(key, editId, existingData){
  currentEditId[key] = editId || null;
  const schema = SCHEMAS[key];
  const container = document.getElementById('form-'+key);
  const data = existingData || {};
  let fieldsHtml = schema.map(([k,label,type]) => {
    const val = esc(data[k]);
    if(type === 'textarea'){
      return '<div class="field"><label>'+label+'</label><textarea id="f_'+key+'_'+k+'">'+val+'</textarea></div>';
    }
    return '<div class="field"><label>'+label+'</label><input type="'+type+'" id="f_'+key+'_'+k+'" value="'+val+'"></div>';
  }).join('');
  container.innerHTML = '<div class="form-card"><h3>'+(editId ? 'Edit' : 'Add new')+'</h3>'
    + fieldsHtml
    + '<button class="btn gold" onclick="saveItem(\''+key+'\')">Save</button> '
    + '<button class="btn ghost" onclick="closeForm(\''+key+'\')">Cancel</button>'
    + '<div class="status-msg" id="formStatus_'+key+'"></div></div>';
};
window.closeForm = function(key){ document.getElementById('form-'+key).innerHTML = ''; };

window.editItem = async function(key, id){
  const { data, error } = await supabase.from(key).select('*').eq('id', id).single();
  if(!error && data) window.openForm(key, id, data);
};

window.deleteItem = async function(key, id){
  if(!confirm('Delete this entry?')) return;
  await supabase.from(key).delete().eq('id', id);
  renderTable(key);
};

window.saveItem = async function(key){
  const schema = SCHEMAS[key];
  const values = {};
  schema.forEach(([k]) => { values[k] = document.getElementById('f_'+key+'_'+k).value.trim(); });
  const statusEl = document.getElementById('formStatus_'+key);
  try{
    let error;
    if(currentEditId[key]){
      ({ error } = await supabase.from(key).update(values).eq('id', currentEditId[key]));
    } else {
      ({ error } = await supabase.from(key).insert(values));
    }
    if(error) throw error;
    statusEl.textContent = 'Saved.';
    statusEl.className = 'status-msg ok';
    statusEl.style.display = 'block';
    renderTable(key);
    setTimeout(() => window.closeForm(key), 700);
  }catch(e){
    statusEl.textContent = 'Could not save — check you are signed in and try again.';
    statusEl.className = 'status-msg err';
    statusEl.style.display = 'block';
  }
};

async function loadSettingsForm(){
  const { data: s } = await supabase.from('settings').select('*').eq('id',1).single();
  if(!s) return;
  document.getElementById('s_sunday').value = s.sunday_times || '';
  document.getElementById('s_wed').value = s.wednesday_times || '';
  document.getElementById('s_address').value = s.address_line || '';
  document.getElementById('s_phone').value = s.phone || '';
  document.getElementById('s_isLive').checked = !!s.is_live;
  document.getElementById('s_liveTitle').value = s.live_title || '';
  document.getElementById('s_liveSub').value = s.live_sub || '';
}
window.saveSettings = async function(){
  const statusEl = document.getElementById('settingsStatus');
  try{
    const { error } = await supabase.from('settings').update({
      sunday_times: document.getElementById('s_sunday').value.trim(),
      wednesday_times: document.getElementById('s_wed').value.trim(),
      address_line: document.getElementById('s_address').value.trim(),
      phone: document.getElementById('s_phone').value.trim(),
      is_live: document.getElementById('s_isLive').checked,
      live_title: document.getElementById('s_liveTitle').value.trim(),
      live_sub: document.getElementById('s_liveSub').value.trim()
    }).eq('id',1);
    if(error) throw error;
    statusEl.textContent = 'Saved.';
    statusEl.className = 'status-msg ok';
    statusEl.style.display = 'block';
  }catch(e){
    statusEl.textContent = 'Could not save — check you are signed in and try again.';
    statusEl.className = 'status-msg err';
    statusEl.style.display = 'block';
  }
};

async function renderPrayerRequests(){
  const { data: items, error } = await supabase.from('prayer_requests').select('*').order('created_at', { ascending:false });
  const tbody = document.getElementById('tbl-prayers');
  if(error || !items || items.length === 0){
    tbody.innerHTML = '<tr><td colspan="6" class="empty-note">No prayer requests yet.</td></tr>';
    return;
  }
  tbody.innerHTML = items.map(p => {
    const when = p.created_at ? new Date(p.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : '—';
    const sharing = p.privacy === 'shareable' ? 'OK to share' : 'Private';
    return '<tr><td>'+esc(p.name)+'</td><td style="max-width:260px;">'+esc(p.request)+'</td><td>'+sharing+'</td><td>'+when+'</td>'
      + '<td><input type="checkbox" '+(p.handled ? 'checked' : '')+' onchange="togglePrayerHandled(\''+p.id+'\', this.checked)"></td>'
      + '<td class="actions"><button class="btn small danger" onclick="deletePrayer(\''+p.id+'\')">Delete</button></td></tr>';
  }).join('');
}

window.togglePrayerHandled = async function(id, handled){
  await supabase.from('prayer_requests').update({ handled }).eq('id', id);
};

window.deletePrayer = async function(id){
  if(!confirm('Delete this prayer request?')) return;
  await supabase.from('prayer_requests').delete().eq('id', id);
  renderPrayerRequests();
};
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Smiths Station Baptist Church</title>
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icon-192.png" type="image/png">
<meta name="theme-color" content="#1C2B4A">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#1C2B4A;
    --navy-deep:#131E33;
    --gold:#D9A441;
    --gold-soft:#F0DDB0;
    --paper:#F8F6F1;
    --paper-dim:#EFEBE1;
    --brick:#8B4A3B;
    --sage:#6E7F5C;
    --ink:#2A2520;
    --ink-soft:#6B655C;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{margin:0;padding:0;height:100%;}
  body{font-family:'Inter',sans-serif; background:var(--paper); color:var(--ink); display:flex; justify-content:center;}
  h1,h2,h3{font-family:'Fraunces',serif; margin:0; font-weight:600;}

  .app{width:100%; max-width:430px; min-height:100vh; background:var(--paper); display:flex; flex-direction:column; position:relative;}

  .topbar{background:var(--navy); color:var(--paper); padding:16px 16px 14px 20px; display:flex; align-items:center; justify-content:space-between;}
  .topbar .mark{display:flex; align-items:center; gap:10px;}
  .topbar .arch-icon{height:28px; width:auto; display:block;}
  .topbar .name{font-family:'Fraunces',serif; font-size:16px; font-weight:600; line-height:1.15;}
  .topbar .name span{display:block; font-family:'Inter',sans-serif; font-size:10.5px; font-weight:500; color:var(--gold-soft); letter-spacing:.02em; margin-top:1px;}
  .icon-btn{background:none; border:none; padding:6px; cursor:pointer; color:var(--paper); display:flex; align-items:center;}
  .icon-btn svg{width:20px; height:20px;}

  .screens{flex:1; overflow-y:auto; padding-bottom:88px;}
  .screen{display:none;}
  .screen.active{display:block;}

  .mini-header{display:flex; align-items:center; gap:10px; padding:18px 20px 6px;}
  .back-btn{background:none; border:none; padding:4px; cursor:pointer; color:var(--navy); display:flex;}
  .back-btn svg{width:20px; height:20px;}
  .mini-header h2{font-size:17px;}

  .hero{background:var(--navy); color:var(--paper); padding:6px 20px 30px; position:relative;}
  .hero .greeting{font-size:22px; line-height:1.25; max-width:78%;}
  .hero .sub{font-size:13.5px; color:#C7D0E0; margin-top:6px;}
  .hero .times{margin-top:20px; display:flex; gap:10px;}
  .time-chip{background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.18); border-radius:3px 3px 10px 10px; padding:9px 12px; flex:1;}
  .time-chip .day{font-size:11px; color:var(--gold-soft); font-weight:600;}
  .time-chip .t{font-size:14px; font-weight:600; margin-top:2px;}

  .live-banner{margin:-16px 20px 0; background:#fff; border:1px solid #E4DFD3; border-radius:8px 8px 20px 20px; padding:13px 14px; display:flex; align-items:center; gap:12px; cursor:pointer; position:relative; z-index:2; box-shadow:0 6px 16px rgba(28,43,74,.08);}
  .live-dot{width:9px; height:9px; border-radius:50%; background:var(--brick); flex-shrink:0; position:relative;}
  .live-dot::after{content:"";position:absolute;inset:-4px;border-radius:50%;border:1.5px solid var(--brick);opacity:.5;}
  .live-text{flex:1;}
  .live-text .lt-title{font-size:13.5px; font-weight:700; color:var(--brick);}
  .live-text .lt-sub{font-size:11.5px; color:var(--ink-soft); margin-top:1px;}

  .section{padding:22px 20px 4px;}
  .section-head{display:flex; align-items:baseline; justify-content:space-between; margin-bottom:12px;}
  .section-head h2{font-size:17px;}
  .section-head .link{font-size:12.5px; color:var(--brick); font-weight:600; cursor:pointer; background:none; border:none; padding:0; font-family:inherit;}

  .arch-card{background:#fff; border:1px solid #E4DFD3; border-radius:26px 26px 8px 8px; padding:18px 18px 16px; margin-bottom:14px; position:relative; overflow:hidden;}
  .arch-card::before{content:""; position:absolute; top:0; left:0; right:0; height:5px; background:var(--gold);}
  .arch-card.event::before{background:var(--sage);}
  .arch-card.give::before{background:var(--brick);}

  .tag{display:inline-block; font-size:11px; font-weight:600; color:var(--sage); background:#EEF0E8; padding:3px 8px; border-radius:2px 2px 8px 8px; margin-bottom:8px;}
  .tag.sermon{color:#9A741F; background:#FBF1DA;}

  .card-title{font-size:16px; margin-bottom:4px;}
  .card-meta{font-size:12.5px; color:var(--ink-soft); margin-bottom:10px;}
  .card-desc{font-size:13.5px; color:var(--ink-soft); line-height:1.5; margin-bottom:12px;}

  .play-row{display:flex; align-items:center; gap:10px;}
  .play-btn{width:38px; height:38px; border-radius:50%; background:var(--navy); border:none; display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0;}
  .play-btn svg{width:14px; height:14px;}
  .track{flex:1; height:4px; background:#E9E4D6; border-radius:2px; position:relative;}
  .track::after{content:"";position:absolute;left:0;top:0;height:100%;width:35%;background:var(--gold);border-radius:2px;}
  .dur{font-size:11.5px; color:var(--ink-soft); flex-shrink:0;}

  .quick-grid{display:grid; grid-template-columns:1fr 1fr; gap:10px;}
  .quick-item{background:#fff; border:1px solid #E4DFD3; border-radius:22px 22px 8px 8px; padding:16px 14px; cursor:pointer; text-align:left;}
  .quick-item .qi-label{font-size:13.5px; font-weight:600; margin-top:8px; display:block;}
  .quick-item .qi-sub{font-size:11.5px; color:var(--ink-soft); margin-top:2px; display:block;}
  .qi-icon{width:22px; height:22px;}

  .event-row{display:flex; gap:14px; background:#fff; border:1px solid #E4DFD3; border-radius:16px 16px 8px 8px; padding:14px; margin-bottom:10px; align-items:flex-start;}
  .date-badge{width:46px; flex-shrink:0; text-align:center; background:var(--paper-dim); border-radius:6px; padding:6px 0;}
  .date-badge .mo{font-size:10px; font-weight:700; color:var(--brick); letter-spacing:.03em;}
  .date-badge .dd{font-size:18px; font-weight:700; font-family:'Fraunces',serif; color:var(--navy); line-height:1.1;}

  .give-hero{background:linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%); color:var(--paper); padding:28px 20px 26px;}
  .give-hero h2{font-size:20px; margin-bottom:6px;}
  .give-hero p{font-size:13px; color:#C7D0E0; line-height:1.5; margin:0;}
  .amount-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin:16px 0 14px;}
  .amt{background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.2); color:#fff; border-radius:8px; padding:10px 0; font-size:13.5px; font-weight:600; text-align:center; cursor:pointer;}
  .amt.selected{background:var(--gold); border-color:var(--gold); color:var(--navy-deep);}
  .give-cta{width:100%; background:var(--gold); color:var(--navy-deep); border:none; padding:13px; border-radius:8px; font-size:14.5px; font-weight:700; font-family:inherit; cursor:pointer;}
  .give-methods{padding:20px;}
  .method-row{display:flex; gap:12px; padding:13px 0; border-bottom:1px solid #E9E4D6; align-items:center;}
  .method-row:last-child{border-bottom:none;}
  .method-icon{width:36px; height:36px; border-radius:9px; background:var(--paper-dim); display:flex; align-items:center; justify-content:center; flex-shrink:0;}
  .method-title{font-size:13.5px; font-weight:600;}
  .method-sub{font-size:12px; color:var(--ink-soft); margin-top:1px;}

  .field{margin-bottom:14px;}
  .field label{display:block; font-size:12.5px; font-weight:600; color:var(--ink-soft); margin-bottom:6px;}
  .field input, .field textarea, .field select{width:100%; border:1px solid #DCD5C4; background:#fff; border-radius:8px; padding:11px 12px; font-family:inherit; font-size:14px; color:var(--ink); resize:vertical;}
  .field textarea{min-height:90px;}
  .submit-btn{width:100%; background:var(--navy); color:#fff; border:none; padding:13px; border-radius:8px; font-size:14.5px; font-weight:700; font-family:inherit; cursor:pointer; margin-top:4px;}
  .confirm-msg{display:none; background:#EEF0E8; border:1px solid #D6DECA; color:var(--sage); font-size:13px; font-weight:600; padding:12px 14px; border-radius:10px; margin-top:12px;}

  .info-block{background:#fff; border:1px solid #E4DFD3; border-radius:16px 16px 8px 8px; padding:16px; margin-bottom:14px;}
  .info-block .it-title{font-size:13px; font-weight:600; color:var(--ink-soft); margin-bottom:4px;}
  .info-block .it-val{font-size:14.5px;}
  .info-block a{color:var(--brick); text-decoration:none; font-weight:600;}

  /* Search */
  .search-box{position:relative; margin-bottom:16px;}
  .search-box input{width:100%; border:1px solid #DCD5C4; background:#fff; border-radius:10px; padding:11px 12px 11px 38px; font-family:inherit; font-size:14px;}
  .search-box svg{position:absolute; left:12px; top:50%; transform:translateY(-50%); width:16px; height:16px; color:var(--ink-soft);}

  /* Directory / deacon / leadership rows */
  .person-row{display:flex; gap:12px; align-items:center; background:#fff; border:1px solid #E4DFD3; border-radius:14px; padding:12px 14px; margin-bottom:10px;}
  .avatar{width:42px; height:42px; border-radius:50%; background:var(--paper-dim); color:var(--navy); display:flex; align-items:center; justify-content:center; font-family:'Fraunces',serif; font-weight:600; font-size:14px; flex-shrink:0;}
  .person-name{font-size:14px; font-weight:600;}
  .person-role{font-size:12px; color:var(--ink-soft); margin-top:1px;}
  .person-contact{font-size:11.5px; color:var(--brick); margin-top:3px; font-weight:600;}
  .letter-head{font-size:12px; font-weight:700; color:var(--ink-soft); margin:16px 0 8px; letter-spacing:.03em;}

  .bio-card{background:#fff; border:1px solid #E4DFD3; border-radius:22px 22px 8px 8px; padding:16px; margin-bottom:12px; display:flex; gap:14px;}
  .bio-avatar{width:56px; height:56px; border-radius:50%; background:var(--gold-soft); color:var(--navy); display:flex; align-items:center; justify-content:center; font-family:'Fraunces',serif; font-weight:600; font-size:17px; flex-shrink:0;}
  .bio-name{font-size:15px; font-weight:600;}
  .bio-role{font-size:12px; color:var(--brick); font-weight:600; margin:2px 0 6px;}
  .bio-text{font-size:13px; color:var(--ink-soft); line-height:1.5;}

  .chip-row{display:flex; gap:8px; overflow-x:auto; padding-bottom:2px; margin-bottom:16px;}
  .chip{flex-shrink:0; font-size:12.5px; font-weight:600; padding:8px 14px; border-radius:20px; background:#fff; border:1px solid #DCD5C4; color:var(--ink-soft); cursor:pointer; white-space:nowrap;}
  .chip.active{background:var(--navy); color:#fff; border-color:var(--navy);}

  .group-card{background:#fff; border:1px solid #E4DFD3; border-radius:16px 16px 8px 8px; padding:14px 16px; margin-bottom:10px;}
  .group-card .g-title{font-size:14.5px; font-weight:600;}
  .group-card .g-meta{font-size:12px; color:var(--ink-soft); margin-top:3px;}
  .group-card .g-desc{font-size:13px; color:var(--ink-soft); margin-top:6px; line-height:1.45;}

  /* Live screen */
  .video-frame{margin:18px 20px 0; background:var(--navy-deep); border-radius:8px 8px 20px 20px; aspect-ratio:16/9; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#C7D0E0; gap:10px;}
  .video-frame svg{width:34px; height:34px; opacity:.85;}
  .video-frame .vf-title{font-size:13px; font-weight:600; color:#fff;}
  .video-frame .vf-sub{font-size:11.5px; color:#9AA6BE;}

  /* Toggle switch */
  .settings-row{display:flex; align-items:center; justify-content:space-between; background:#fff; border:1px solid #E4DFD3; border-radius:14px; padding:14px 16px; margin-bottom:10px;}
  .settings-text .st-title{font-size:14px; font-weight:600;}
  .settings-text .st-sub{font-size:11.5px; color:var(--ink-soft); margin-top:2px;}
  .switch{width:42px; height:24px; border-radius:12px; background:#DCD5C4; position:relative; cursor:pointer; flex-shrink:0; transition:background .15s;}
  .switch::after{content:""; position:absolute; top:2px; left:2px; width:20px; height:20px; border-radius:50%; background:#fff; transition:left .15s;}
  .switch.on{background:var(--sage);}
  .switch.on::after{left:20px;}

  .install-banner{margin:0 20px 16px; background:var(--gold-soft); border:1px solid #E4C482; border-radius:14px; padding:13px 14px; display:none; align-items:center; gap:12px;}
  .install-banner.show{display:flex;}
  .install-banner .ib-text{flex:1; font-size:12.5px; color:#5C4A1E; font-weight:600; line-height:1.4;}
  .install-banner button{background:var(--navy); color:#fff; border:none; border-radius:8px; padding:8px 12px; font-size:12px; font-weight:700; font-family:inherit; cursor:pointer; flex-shrink:0;}

  .tabbar{position:absolute; left:0; right:0; bottom:0; background:#fff; border-top:1px solid #E4DFD3; display:flex; padding:8px 6px calc(8px + env(safe-area-inset-bottom)); max-width:430px; margin:0 auto; width:100%;}
  .tab{flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; background:none; border:none; padding:6px 2px; cursor:pointer; color:#A79F8E;}
  .tab svg{width:20px; height:20px;}
  .tab .tlabel{font-size:10.5px; font-weight:600;}
  .tab.active{color:var(--navy);}
  .tab.active .tlabel{color:var(--navy);}

  ::-webkit-scrollbar{display:none;}
</style>
</head>
<body>
<div class="app">

  <div class="topbar">
    <div class="mark">
      <img class="arch-icon" src="data:image/png;base64," alt="Smiths Station Baptist Church">
      <div class="name">Smiths Station Baptist<span>Smiths Station, Alabama</span></div>
    </div>
    <button class="icon-btn" onclick="openScreen('settings')" aria-label="Notification settings">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 01-3.4 0"/></svg>
    </button>
  </div>

  <div class="screens">

    <!-- HOME -->
    <div class="screen active" id="screen-home">
      <div class="hero">
        <div class="greeting" id="greetingText">Welcome home.</div>
        <div class="sub">You're always welcome here, whoever you are.</div>
        <div class="times">
          <div class="time-chip"><div class="day">Sunday</div><div class="t" id="sundayTimeText">—</div></div>
          <div class="time-chip"><div class="day">Wednesday</div><div class="t" id="wedTimeText">—</div></div>
        </div>
      </div>

      <div class="live-banner" id="liveBanner" onclick="openScreen('live')" style="display:none;">
        <div class="live-dot"></div>
        <div class="live-text">
          <div class="lt-title" id="liveTitleText">Live now · Sunday worship</div>
          <div class="lt-sub" id="liveSubText">Tap to watch the service</div>
        </div>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#A79F8E" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </div>

      <div class="install-banner" id="installBanner">
        <div class="ib-text">Add this app to your home screen for one-tap access.</div>
        <button onclick="installApp()">Install</button>
      </div>

      <div class="section">
        <div class="section-head"><h2>This week</h2><button class="link" onclick="showTab('events')">See all</button></div>
        <div id="homeNextEvent">
          <div class="card-desc">Loading...</div>
        </div>
      </div>

      <div class="section">
        <div class="section-head"><h2>Latest message</h2><button class="link" onclick="showTab('sermons')">See all</button></div>
        <div id="homeLatestSermon">
          <div class="card-desc">Loading...</div>
        </div>
      </div>

      <div class="section">
        <div class="section-head"><h2>Quick actions</h2></div>
        <div class="quick-grid">
          <button class="quick-item" onclick="showTab('give')">
            <svg class="qi-icon" viewBox="0 0 24 24" fill="none" stroke="#8B4A3B" stroke-width="1.8"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
            <span class="qi-label">Give</span><span class="qi-sub">Support the church</span>
          </button>
          <button class="quick-item" onclick="showTab('connect')">
            <svg class="qi-icon" viewBox="0 0 24 24" fill="none" stroke="#6E7F5C" stroke-width="1.8"><path d="M12 21s-7-4.6-9.5-9A5.5 5.5 0 0112 5.5 5.5 5.5 0 0121.5 12c-2.5 4.4-9.5 9-9.5 9z"/></svg>
            <span class="qi-label">Prayer request</span><span class="qi-sub">We'd love to pray</span>
          </button>
          <button class="quick-item" onclick="alert('Prototype only — this will open turn-by-turn directions to the church.')">
            <svg class="qi-icon" viewBox="0 0 24 24" fill="none" stroke="#D9A441" stroke-width="1.8"><path d="M12 22s7-7.4 7-12.5A7 7 0 105 9.5C5 14.6 12 22 12 22z"/><circle cx="12" cy="9.5" r="2.3"/></svg>
            <span class="qi-label">Directions</span><span class="qi-sub">Get here Sunday</span>
          </button>
          <button class="quick-item" onclick="openScreen('groups')">
            <svg class="qi-icon" viewBox="0 0 24 24" fill="none" stroke="#1C2B4A" stroke-width="1.8"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
            <span class="qi-label">Connect groups</span><span class="qi-sub">Find a small group</span>
          </button>
          <button class="quick-item" onclick="openScreen('directory')">
            <svg class="qi-icon" viewBox="0 0 24 24" fill="none" stroke="#6E7F5C" stroke-width="1.8"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c0-3.6 2.5-6 5.5-6s5.5 2.4 5.5 6"/><circle cx="17.5" cy="9" r="2.3"/><path d="M15.5 13.5c2.4.3 4 2.2 4 6.5"/></svg>
            <span class="qi-label">Church directory</span><span class="qi-sub">Find a member</span>
          </button>
          <button class="quick-item" onclick="openScreen('deacons')">
            <svg class="qi-icon" viewBox="0 0 24 24" fill="none" stroke="#8B4A3B" stroke-width="1.8"><path d="M12 2l7 3v6c0 5-3.4 8.4-7 11-3.6-2.6-7-6-7-11V5z"/></svg>
            <span class="qi-label">Deacon list</span><span class="qi-sub">Care &amp; contacts</span>
          </button>
        </div>
      </div>
    </div>

    <!-- SERMONS -->
    <div class="screen" id="screen-sermons">
      <div class="section" style="padding-top:20px;">
        <div class="section-head"><h2>Sermons</h2></div>
        <div id="sermonsList">
          <div class="card-desc">Loading...</div>
        </div>
      </div>
    </div>

    <!-- EVENTS -->
    <div class="screen" id="screen-events">
      <div class="section" style="padding-top:20px;">
        <div class="section-head"><h2>Upcoming events</h2></div>
        <div id="eventsList">
          <div class="card-desc">Loading...</div>
        </div>
      </div>
    </div>

    <!-- GIVE -->
    <div class="screen" id="screen-give">
      <div class="give-hero">
        <h2>Give</h2>
        <p>Your generosity supports our church family, our missions, and our community outreach.</p>
        <div class="amount-grid">
          <div class="amt" onclick="selectAmt(this)">$25</div>
          <div class="amt selected" onclick="selectAmt(this)">$50</div>
          <div class="amt" onclick="selectAmt(this)">$100</div>
          <div class="amt" onclick="selectAmt(this)">Other</div>
        </div>
        <button class="give-cta" onclick="alert('Prototype only — a real giving flow (Tithe.ly, Pushpay, etc.) would connect here.')">Give $50 now</button>
      </div>
      <div class="give-methods">
        <div class="section-head" style="margin-bottom:6px;"><h2 style="font-size:15px;">Other ways to give</h2></div>
        <div class="method-row"><div class="method-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1C2B4A" stroke-width="1.8"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 9h20"/></svg></div><div><div class="method-title">Text to give</div><div class="method-sub">Text an amount to <span id="giveTextPhone">—</span></div></div></div>
        <div class="method-row"><div class="method-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1C2B4A" stroke-width="1.8"><path d="M20 12v6a2 2 0 01-2 2H6a2 2 0 01-2-2v-6M16 6l-4-4-4 4M12 2v14"/></svg></div><div><div class="method-title">In-service offering</div><div class="method-sub">Give during Sunday worship</div></div></div>
        <div class="method-row"><div class="method-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1C2B4A" stroke-width="1.8"><path d="M4 4h16v16H4z"/><path d="M4 9h16M9 4v16"/></svg></div><div><div class="method-title">Mail a check</div><div class="method-sub" id="giveMailAddress">—</div></div></div>
      </div>
    </div>

    <!-- CONNECT -->
    <div class="screen" id="screen-connect">
      <div class="section" style="padding-top:20px;">
        <div class="section-head"><h2>Prayer request</h2></div>
        <div class="arch-card">
          <div class="field"><label>Your name</label><input type="text" id="prayerName" placeholder="Jane Smith"></div>
          <div class="field"><label>Your request</label><textarea id="prayerText" placeholder="Share what's on your heart..."></textarea></div>
          <div class="field"><label>Keep this private to the prayer team?</label><select id="prayerPrivacy"><option value="private">Yes, keep it private</option><option value="shareable">It's okay to share with the church family</option></select></div>
          <button class="submit-btn" id="prayerSubmitBtn" onclick="submitPrayer()">Send request</button>
          <div class="confirm-msg" id="prayerConfirm">Thank you — our prayer team will be praying for you this week.</div>
        </div>
      </div>
      <div class="section">
        <div class="section-head"><h2>Leadership</h2><button class="link" onclick="openScreen('leadership')">See all</button></div>
        <div id="connectLeadershipPreview">
          <div class="card-desc">Loading...</div>
        </div>
      </div>
      <div class="section">
        <div class="section-head"><h2>Visiting us</h2></div>
        <div class="info-block"><div class="it-title">Address</div><div class="it-val"><a href="#" onclick="return false;" id="visitAddress">—</a></div></div>
        <div class="info-block"><div class="it-title">Phone</div><div class="it-val"><a href="#" onclick="return false;" id="visitPhone">—</a></div></div>
        <div class="info-block"><div class="it-title">New here?</div><div class="it-val">Stop by the welcome table in the foyer any Sunday — someone will be glad to show you around.</div></div>
      </div>
    </div>

    <!-- LIVE STREAM -->
    <div class="screen" id="screen-live">
      <div class="mini-header"><button class="back-btn" onclick="showTab('home')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg></button><h2>Watch live</h2></div>
      <div class="video-frame">
        <svg viewBox="0 0 24 24" fill="none" stroke="#C7D0E0" stroke-width="1.6"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M10 9.5v5l4-2.5z" fill="#C7D0E0" stroke="none"/></svg>
        <div class="vf-title">Live video connects here</div>
        <div class="vf-sub">Embed your YouTube/Facebook Live stream ID</div>
      </div>
      <div class="section">
        <div class="card-desc">This screen is ready for a live embed — once you have a streaming provider (YouTube Live, Facebook Live, or Church Online Platform), we drop the embed code in here and it plays right in the app during service times.</div>
      </div>
    </div>

    <!-- CHURCH DIRECTORY -->
    <div class="screen" id="screen-directory">
      <div class="mini-header"><button class="back-btn" onclick="showTab('home')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg></button><h2>Church directory</h2></div>
      <div class="section" style="padding-top:8px;">
        <div class="search-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          <input type="text" placeholder="Search members...">
        </div>
        <div id="directoryList">
          <div class="card-desc">Loading...</div>
        </div>
